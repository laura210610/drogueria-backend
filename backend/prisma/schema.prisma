
generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["proyecto10"]
}

model Usuario {
  id         Int     @id @default(autoincrement())
  nombre     String
  correo     String  @unique
  usuario    String  @unique
  contrasena String
  rol        String  @default("cliente")
  ventas     Venta[]

  @@schema("proyecto10")
}

model Medicamento {
  id             String          @id
  nombre         String
  laboratorio    String
  descripcion    String
  stock          Int
  precioCompra   Float
  precioVenta    Float
  estado         String          @default("Activo")
  detallesCompra DetalleCompra[]
  detallesVenta  DetalleVenta[]

  @@schema("proyecto10")
}

model Compra {
  id            Int             @id @default(autoincrement())
  fecha         DateTime
  proveedor     String
  numeroFactura String
  total         Float
  detalles      DetalleCompra[]

  @@schema("proyecto10")
}

model DetalleCompra {
  id               Int         @id @default(autoincrement())
  compraId         Int
  medicamentoId    String
  cantidad         Int
  precioCompra     Float
  precioVenta      Float
  fechaVencimiento DateTime?
  total            Float
  compra           Compra      @relation(fields: [compraId], references: [id], onDelete: Cascade)
  medicamento      Medicamento @relation(fields: [medicamentoId], references: [id])

  @@schema("proyecto10")
}

model Venta {
  id        Int            @id @default(autoincrement())
  usuarioId Int?
  cliente   String
  factura   String
  fecha     DateTime
  total     Float
  detalles  DetalleVenta[]
  usuario   Usuario?       @relation(fields: [usuarioId], references: [id])

  @@schema("proyecto10")
}

model DetalleVenta {
  id            Int         @id @default(autoincrement())
  ventaId       Int
  medicamentoId String
  cantidad      Int
  precio        Float
  total         Float
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id])
  venta         Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@schema("proyecto10")
}
