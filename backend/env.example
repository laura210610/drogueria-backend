# Plantilla de variables de entorno del backend.
# Copiar el contenido a un archivo .env en esta misma carpeta y completar los valores.
# El archivo .env está en .gitignore: nunca se versiona.

# Conexion a PostgreSQL. El esquema que usa Prisma se llama "proyecto10".
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE?sslmode=require
DATABASE_URL="postgresql://usuario:contrasena@host:5432/base?sslmode=require"

# Clave para firmar los JWT. Obligatoria: sin ella el backend no arranca.
# Generar una nueva con: openssl rand -base64 48
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Vida del token en segundos. Debe ser un numero (no "1h" ni "7d").
JWT_EXPIRES_IN=3600

# Puerto HTTP. El frontend espera 3000.
PORT=3000

# Credenciales del administrador inicial, para crear-admin.ts.
# Nunca se versionan claves reales: este archivo solo muestra los nombres.
# Uso: ADMIN_CONTRASENA="..." npx ts-node crear-admin.ts
# Si el usuario ya existe y querés reescribir su clave: agregá --reset
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@drogueriapili.com
ADMIN_CONTRASENA=cambiar-por-una-clave-de-8-o-mas-caracteres
ADMIN_RESET=0

# Origen del frontend permitido por CORS. El default es http://localhost:4200.
# Varios orígenes se separan por comas: https://a.com,https://b.com
CORS_ORIGIN=http://localhost:4200
